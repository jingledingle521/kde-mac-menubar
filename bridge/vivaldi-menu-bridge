# Linux input event codes (linux/input-event-codes.h).
KEYCODES = {
    'ctrl': 29, 'shift': 42, 'alt': 56, 'meta': 125, 'esc': 1, 'tab': 15, 'enter': 28, 'space': 57,
    'backspace': 14, 'delete': 111, 'left': 105, 'right': 106, 'up': 103, 'down': 108,
    'pageup': 104, 'pagedown': 109, 'home': 102, 'end': 107, 'minus': 12, 'equal': 13, 'plus': 13,
    'comma': 51, 'period': 52, 'slash': 53,
}
KEYCODES.update({f'f{i}': c for i, c in zip(range(1, 11), range(59, 69))})
KEYCODES.update({'f11': 87, 'f12': 88})
KEYCODES.update(dict(zip('1234567890', range(2, 12))))
KEYCODES.update(dict(zip('qwertyuiop', range(16, 26))))
KEYCODES.update(dict(zip('asdfghjkl', range(30, 39))))
KEYCODES.update(dict(zip('zxcvbnm', range(44, 51))))


def press(combo):
    """Type a combination like "ctrl+shift+t" into the focused window."""
    try:
        codes = [KEYCODES[k] for k in combo.lower().split('+')]
    except KeyError:
        return
    events = [f'{c}:1' for c in codes] + [f'{c}:0' for c in reversed(codes)]
    env = dict(os.environ)
    sock = f'/run/user/{os.getuid()}/.ydotool_socket'
    if 'YDOTOOL_SOCKET' not in env and os.path.exists(sock):
        env['YDOTOOL_SOCKET'] = sock
    # Give the menu time to close so the browser has focus again.
    time.sleep(0.15)
    subprocess.run(['ydotool', 'key', *events], env=env, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


# ---- WebSocket server (just enough of RFC 6455 for one local client) -------
class Client:
    def __init__(self, conn):
        self.conn = conn
        self.lock = threading.Lock()

    def send(self, obj):
        data = json.dumps(obj).encode()
        header = bytearray([0x81])
        if len(data) < 126:
            header.append(len(data))
        elif len(data) < 65536:
            header.append(126)
            header += struct.pack('>H', len(data))
        else:
            header.append(127)
            header += struct.pack('>Q', len(data))
        with self.lock:
            self.conn.sendall(bytes(header) + data)

    def recv_exact(self, n):
        buf = b''
        while len(buf) < n:
            chunk = self.conn.recv(n - len(buf))
            if not chunk:
                raise ConnectionError
            buf += chunk
        return buf

    def recv(self):
        """Next text message, or None on close. Handles pings and fragments."""
        message = b''
        while True:
            b0, b1 = self.recv_exact(2)
            opcode, length = b0 & 0x0F, b1 & 0x7F
            if length == 126:
                length = struct.unpack('>H', self.recv_exact(2))[0]
            elif length == 127:
                length = struct.unpack('>Q', self.recv_exact(8))[0]
            if length > 8 * 1024 * 1024:
                raise ConnectionError('frame too large')
            mask = self.recv_exact(4) if b1 & 0x80 else None
            payload = self.recv_exact(length)
            if mask:
                payload = bytes(p ^ mask[i % 4] for i, p in enumerate(payload))
            if opcode == 0x8:
                return None
            if opcode == 0x9:  # ping
                with self.lock:
                    self.conn.sendall(bytes([0x8A, len(payload)]) + payload)
                continue
            if opcode in (0x1, 0x0):
                message += payload
                if b0 & 0x80:
                    return message.decode()


# ---- Global menu (com.canonical.dbusmenu) ------------------------------------
# The structure mirrors Vivaldi's own menus. Items run an extension command
# (cmd) when it's connected, otherwise type their shortcut (keys).
def item(label, cmd=None, keys=None, args=None, check=None, hidden=False):
    """A menu item. `check` names a Vivaldi setting shown as a checkmark;
    `hidden` keys are internal bindings (see VIVALDI_BINDINGS), not shown."""
    return {'label': label, 'cmd': cmd, 'keys': keys, 'args': args, 'check': check, 'hidden': hidden}


