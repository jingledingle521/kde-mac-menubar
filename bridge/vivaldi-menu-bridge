def vivaldi_prefs_path():
    for path in ('~/snap/vivaldi/current/.config/vivaldi/Default/Preferences', '~/.config/vivaldi/Default/Preferences'):
        path = os.path.expanduser(path)
        if os.path.exists(path):
            return path
    return None


_prefs_cache = {'mtime': None, 'data': {}}


def vivaldi_prefs():
    """Vivaldi's settings (re-read when the file changes)."""
    path = vivaldi_prefs_path()
    try:
        mtime = os.path.getmtime(path)
        if mtime != _prefs_cache['mtime']:
            with open(path) as f:
                _prefs_cache['data'] = json.load(f)
            _prefs_cache['mtime'] = mtime
    except (TypeError, OSError, ValueError):
        pass
    return _prefs_cache['data']


def pref(path, default=None):
    node = vivaldi_prefs()
    for key in path.split('.'):
        if not isinstance(node, dict) or key not in node:
            return default
        node = node[key]
    return node


# Checkmark state for View items, from Vivaldi's settings (key names and
# defaults from Vivaldi's prefs_definitions.json). Vivaldi saves a change to
# its settings file a moment after it happens.
CHECKS = {
    'tabbar': lambda: pref('vivaldi.tabs.visible', True) is not False,
    'addressbar': lambda: pref('vivaldi.address_bar.visible', True) is not False,
    'bookmarksbar': lambda: pref('vivaldi.bookmarks.bar.visible', False) is True,
    'statusbar': lambda: pref('vivaldi.status_bar.display', 0) != 2,  # 2 = off
    'panel': lambda: pref('vivaldi.panels.window_defaults.barVisible', True) is not False,
}


# Vivaldi batches settings writes (up to ~10 s), so after the user toggles
# something from our menu, show the flipped state until the file catches up.
_check_overrides = {}  # check name -> (value, time of the click)


def check_state(name):
    override = _check_overrides.get(name)
    if override:
        value, clicked = override
        path = vivaldi_prefs_path()
        try:
            saved_since = os.path.getmtime(path) > clicked + 0.2
        except (TypeError, OSError):
            saved_since = False
        if not saved_since and time.time() - clicked < 30:
            return value
        del _check_overrides[name]
    return CHECKS[name]()


def note_toggle(name):
    _check_overrides[name] = (not check_state(name), time.time())


def bind_vivaldi_shortcuts():
    """Write VIVALDI_BINDINGS into Vivaldi's settings. Vivaldi must be closed."""
    path = vivaldi_prefs_path()
    if not path:
        sys.exit('Vivaldi settings not found')
    # Match the browser's own command line from its start (an unanchored
    # pattern would also match whatever shell is running this).
    running = subprocess.run(['pgrep', '-f', r'^(/snap/vivaldi/[0-9]+)?/opt/vivaldi/vivaldi'],
                             stdout=subprocess.DEVNULL).returncode == 0
    if running:
        sys.exit('Quit Vivaldi first (Ctrl+Q): it rewrites its settings while running.')
    with open(path) as f:
        data = json.load(f)
    actions = data.setdefault('vivaldi', {}).setdefault('actions', [{}])
    if not actions:
        actions.append({})
    for command, key in VIVALDI_BINDINGS.items():
        entry = actions[0].setdefault(command, {'shortcuts': []})
        shortcuts = entry.setdefault('shortcuts', [])
        if key not in shortcuts:
            shortcuts.append(key)
    if not os.path.exists(path + '.before-mac-menu'):  # keep the original
        shutil.copy2(path, path + '.before-mac-menu')
    with open(path, 'w') as f:
        json.dump(data, f, separators=(',', ':'))
    print(f'Bound {len(VIVALDI_BINDINGS)} Vivaldi commands (backup: {path}.before-mac-menu)')


